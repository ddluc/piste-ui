{
  "name": "piste-ui",
  "version": "0.0.2",
  "description": "A modular and configurable UI framework for web engineers ",
  "main": "index.js",
  "scripts": {
    "dev": "webpack-dev-server --config webpack/webpack.dev.js",
    "test": "jest --config jest.config.json src/",
    "test:verbose": "jest --verbose --config jest.config.json src/",
    "test:coverage": "jest --coverage --silent",
    "build": "webpack --config webpack/webpack.prod.js; ./scripts/postbuild.sh",
    "lint": " eslint --ext ts,tsx src/",
    "storybook": "start-storybook -p 6006",
    "build-storybook": "build-storybook -o ./docs",
    "scaffold:component": "./scripts/scaffold/component.sh",
    "yalc:push": "yalc publish --push",
    "sync": "nodemon --watch src --ext ts,tsx --exec 'npm run yalc:push'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ddluc/piste-ui.git"
  },
  "keywords": [
    "react",
    "ui framework",
    "design system",
    "component",
    "ui"
  ],
  "author": "Daniel Lucas",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/ddluc/piste-ui/issues"
  },
  "homepage": "https://github.com/ddluc/piste-ui",
  "devDependencies": {
    "@babel/core": "^7.16.7",
    "@babel/preset-env": "^7.16.7",
    "@babel/preset-react": "^7.16.7",
    "@storybook/addon-actions": "^6.4.9",
    "@storybook/addon-essentials": "^6.4.9",
    "@storybook/addon-links": "^6.4.9",
    "@storybook/builder-webpack5": "^6.4.9",
    "@storybook/manager-webpack5": "^6.4.9",
    "@storybook/react": "^6.4.9",
    "@svgr/webpack": "^6.2.1",
    "@testing-library/jest-dom": "^5.16.2",
    "@testing-library/react": "^12.1.3",
    "@testing-library/react-hooks": "^7.0.2",
    "@types/faker": "^5.5.9",
    "@types/jest": "^27.4.1",
    "@types/react": "^17.0.38",
    "@types/react-dom": "^17.0.11",
    "@types/styled-components": "^5.1.19",
    "@typescript-eslint/eslint-plugin": "^5.12.1",
    "@typescript-eslint/parser": "^5.12.1",
    "babel-core": "^6.26.3",
    "babel-jest": "^27.5.1",
    "babel-loader": "^8.2.3",
    "babel-preset-react": "^6.24.1",
    "clean-webpack-plugin": "^4.0.0",
    "eslint": "^8.9.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-react": "^7.29.1",
    "eslint-plugin-react-hooks": "^4.3.0",
    "faker": "^5.5.3",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.5.0",
    "jest": "^27.5.1",
    "jest-styled-components": "^7.0.8",
    "nodemon": "^2.0.19",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "storybook-addon-styled-component-theme": "^2.0.0",
    "styled-components": "^5.3.3",
    "ts-jest": "^27.1.3",
    "ts-loader": "^9.2.6",
    "typescript": "^4.5.4",
    "url-loader": "^4.1.1",
    "webpack": "^5.65.0",
    "webpack-cli": "^4.9.1",
    "webpack-dev-server": "^4.7.2"
  },
  "peerDependencies": {
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "styled-components": "^5.3.3"
  }
}
