{
  "compilerOptions": {
    "outDir": "./dist/",
    "lib": ["dom", "es6"],
    "noImplicitAny": true,
    "module": "esnext",
    "target": "es6",
    "jsx": "react",
    "moduleResolution": "node",
    "declaration": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": false,
    "sourceMap": true
  }, 
  "exclude": [
    // Don't build development scripts  
    "./scripts/",
    // Don't build test configuration scripts
    "./test/", 
    // Don't build test implemenations
    "./**/*.test.ts", 
    "./**/*.test.tsx", 
    // Don't build the build folder 
    // It seems obvious, but it will cause an error if you don't specify)
    "./dist/*"
  ]
}